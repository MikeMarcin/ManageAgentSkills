{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:workflow-requirements:v1",
  "$comment": "PROPOSED pack contract. Runtime must additionally enforce containment, reserved paths, no aliases/collisions, declared references, native-field safety and ownership. This is not authorization to execute package code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inputs",
    "native_roles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inputs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "kind",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$"
          },
          "kind": {
            "enum": [
              "json",
              "text"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "native_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent",
          "name"
        ],
        "properties": {
          "agent": {
            "enum": [
              "codex",
              "claude"
            ]
          },
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          },
          "asset": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "setup": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "oneOf": [
          {
            "required": [
              "asset"
            ],
            "not": {
              "required": [
                "setup"
              ]
            }
          },
          {
            "required": [
              "setup"
            ],
            "not": {
              "required": [
                "asset"
              ]
            }
          }
        ]
      }
    },
    "setup": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "entrypoint",
          "inputs",
          "package_inputs",
          "parameters",
          "timeout_seconds",
          "effects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 64
          },
          "entrypoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$"
          },
          "inputs": {
            "type": "array",
            "uniqueItems": true,
            "maxItems": 32,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "package_inputs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\x00-\\x1f]+$"
            }
          },
          "parameters": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "type": [
                "string",
                "boolean",
                "integer",
                "null"
              ]
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "effects": {
            "const": "staged-native-roles"
          }
        }
      }
    }
  }
}
