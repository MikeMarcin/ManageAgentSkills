{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:result:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "tool_version",
    "command",
    "ok",
    "dry_run",
    "changed",
    "would_change",
    "transaction",
    "data",
    "actions",
    "warnings",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "tool": {
      "const": "mask"
    },
    "tool_version": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "changed": {
      "type": "boolean"
    },
    "would_change": {
      "type": "boolean"
    },
    "transaction": {
      "enum": [
        "not_started",
        "not_needed",
        "committed",
        "rolled_back",
        "partial"
      ]
    },
    "data": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "status"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "status": {
            "enum": [
              "planned",
              "applied",
              "not_applied",
              "failed",
              "rolled_back",
              "retained",
              "noop"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable",
            "details",
            "remediation"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            },
            "remediation": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "message"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "inspect",
                      "retry",
                      "manual",
                      "recover"
                    ]
                  },
                  "message": {
                    "type": "string"
                  },
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "dry_run": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "changed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "null"
          },
          "transaction": {
            "not": {
              "const": "partial"
            }
          }
        }
      },
      "else": {
        "properties": {
          "error": {
            "type": "object"
          }
        }
      }
    }
  ]
}
