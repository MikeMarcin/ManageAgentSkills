{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation",
    "projects",
    "launchers",
    "user"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "root_identity",
              "last_manifest",
              "last_manifest_digest",
              "last_source_revision",
              "links"
            ],
            "properties": {
              "root": {
                "type": "string"
              },
              "root_identity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device",
                  "inode"
                ],
                "properties": {
                  "device": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "inode": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "last_manifest": {
                "$ref": "project.schema.json"
              },
              "last_manifest_digest": {
                "type": "string"
              },
              "last_source_revision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "links": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "skill",
                    "target",
                    "link_text"
                  ],
                  "properties": {
                    "skill": {
                      "type": "string"
                    },
                    "target": {
                      "enum": [
                        "claude",
                        "codex"
                      ]
                    },
                    "link_text": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "root",
              "root_identity",
              "last_manifest",
              "last_manifest_digest",
              "last_source_revision",
              "links",
              "mode",
              "last_lock"
            ],
            "properties": {
              "root": {
                "type": "string"
              },
              "root_identity": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "device",
                  "inode"
                ],
                "properties": {
                  "device": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "inode": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "last_manifest": {
                "$ref": "project-v2.schema.json"
              },
              "last_manifest_digest": {
                "type": "string"
              },
              "last_source_revision": {
                "type": "null"
              },
              "links": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "skill",
                    "target",
                    "link_text",
                    "resolution"
                  ],
                  "properties": {
                    "skill": {
                      "type": "string"
                    },
                    "target": {
                      "enum": [
                        "claude",
                        "codex"
                      ]
                    },
                    "link_text": {
                      "type": "string"
                    },
                    "resolution": {
                      "$ref": "lock-v1.schema.json#/properties/packages/items"
                    },
                    "dev": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source",
                        "id",
                        "root",
                        "identity",
                        "path"
                      ],
                      "properties": {
                        "source": {
                          "type": "string"
                        },
                        "id": {
                          "type": "string"
                        },
                        "root": {
                          "type": "string"
                        },
                        "identity": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "device",
                            "inode"
                          ],
                          "properties": {
                            "device": {
                              "type": "integer",
                              "minimum": 0
                            },
                            "inode": {
                              "type": "integer",
                              "minimum": 0
                            }
                          }
                        },
                        "path": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              },
              "mode": {
                "enum": [
                  "pinned",
                  "dev-link"
                ]
              },
              "last_lock": {
                "$ref": "lock-v1.schema.json"
              },
              "dev_links": {
                "type": "object",
                "maxProperties": 4096,
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "id",
                    "root",
                    "identity",
                    "path"
                  ],
                  "properties": {
                    "source": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "root": {
                      "type": "string"
                    },
                    "identity": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "device",
                        "inode"
                      ],
                      "properties": {
                        "device": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "inode": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    },
                    "path": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "launchers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_root",
          "interpreter",
          "content_digest"
        ],
        "properties": {
          "program_root": {
            "type": "string"
          },
          "interpreter": {
            "type": "string"
          },
          "content_digest": {
            "type": "string"
          }
        }
      }
    },
    "user": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/properties/projects/additionalProperties"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:state:v3",
  "$comment": "Runtime additionally checks canonical roots, manifest digests, source revisions and recomputed ownership paths."
}
