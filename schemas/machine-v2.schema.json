{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:machine:v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "default_targets",
    "git_timeout_seconds",
    "legacy_source",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "remote",
        "branch"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "default_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude",
          "codex"
        ]
      }
    },
    "git_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "legacy_source": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "transport",
          "cache",
          "ref",
          "packages",
          "authoring"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "type": "string",
            "minLength": 1
          },
          "cache": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "packages": {
            "type": "string",
            "minLength": 1
          },
          "authoring": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Repository is a normalized credential-free HTTPS, SSH or local file identity. Transport must match it. Legacy source root is preserved. Cache and authoring paths are machine-local. Runtime additionally validates URI/ref/path safety and catalog ownership."
}
