{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:project:v1",
  "title": "MASK project declaration v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skills"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude",
          "codex"
        ]
      }
    }
  },
  "$comment": "Semantic validator also rejects Windows reserved device names and the host-reserved skill id synced. JSON parsing rejects duplicate keys."
}
