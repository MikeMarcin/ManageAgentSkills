{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generation",
    "projects",
    "launchers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "root",
          "root_identity",
          "last_manifest",
          "last_manifest_digest",
          "last_source_revision",
          "links"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "root_identity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device",
              "inode"
            ],
            "properties": {
              "device": {
                "type": "integer",
                "minimum": 0
              },
              "inode": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "last_manifest": {
            "$ref": "project.schema.json"
          },
          "last_manifest_digest": {
            "type": "string"
          },
          "last_source_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "links": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill",
                "target",
                "link_text"
              ],
              "properties": {
                "skill": {
                  "type": "string"
                },
                "target": {
                  "enum": [
                    "claude",
                    "codex"
                  ]
                },
                "link_text": {
                  "type": "string"
                }
              }
            }
          },
          "native_roles": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "skill",
                "agent",
                "name",
                "sha256"
              ],
              "properties": {
                "skill": {
                  "type": "string"
                },
                "agent": {
                  "enum": [
                    "claude",
                    "codex"
                  ]
                },
                "name": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      }
    },
    "launchers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "program_root",
          "interpreter",
          "content_digest"
        ],
        "properties": {
          "program_root": {
            "type": "string"
          },
          "interpreter": {
            "type": "string"
          },
          "content_digest": {
            "type": "string"
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:state:v1",
  "$comment": "Runtime additionally checks canonical roots, manifest digests, source revisions and recomputed ownership paths."
}
