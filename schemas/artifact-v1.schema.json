{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:artifact:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "payload_digest",
    "metadata_digest",
    "files"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "files": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "mode",
          "size",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 1024
          },
          "mode": {
            "enum": [
              "100644",
              "100755"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metadata_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "provenance_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$comment": "Runtime verifies sorted unique files, bounded raw bytes/derived directories, payload and metadata digests, complete no-link inventory and logical modes. No source/revision identity: identical content may be shared."
}
