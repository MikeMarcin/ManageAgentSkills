{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:machine:v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "default_targets",
    "git_timeout_seconds",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "default_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude",
          "codex"
        ]
      }
    },
    "git_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    },
    "sources": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 256,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "transport",
          "cache",
          "ref",
          "packages",
          "authoring"
        ],
        "properties": {
          "repository": {
            "type": "string",
            "minLength": 1
          },
          "transport": {
            "type": "string",
            "minLength": 1
          },
          "cache": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "packages": {
            "type": "string",
            "minLength": 1
          },
          "authoring": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  },
  "$comment": "Machine configuration v3 (RFC-MASK-0020): every skill source is a tap. There is no live source block and no legacy_source. Repository is a normalized credential-free HTTPS, SSH or local file identity; transport must match it; cache and authoring are machine-local absolute paths. An authoring checkout is for publishing and explicit dev-link only. Runtime additionally validates URI/ref/path safety and catalog ownership. Versions 1 and 2 remain readable."
}
