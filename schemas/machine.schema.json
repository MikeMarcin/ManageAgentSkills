{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mask:machine:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "default_targets",
    "git_timeout_seconds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "remote",
        "branch"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "default_targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claude",
          "codex"
        ]
      }
    },
    "git_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 600
    }
  },
  "$comment": "root must be an absolute validated local checkout. remote/branch use Git validation and cannot be option injection. No credentials or URLs."
}
