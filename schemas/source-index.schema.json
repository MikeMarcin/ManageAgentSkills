{
  "$comment": "Source-owned flat catalog and explicit bundle definitions. Runtime validates bounded sets, exact paths, package IDs and bindings. No machine approval or setup authority is granted.",
  "$id": "urn:mask:source-index:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "bundles": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "skills": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "agents": {
                  "oneOf": [
                    {
                      "const": "all"
                    },
                    {
                      "items": {
                        "enum": [
                          "claude",
                          "codex"
                        ]
                      },
                      "minItems": 1,
                      "type": "array",
                      "uniqueItems": true
                    }
                  ]
                },
                "id": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "type": "string"
                },
                "introduced_by": {
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "minItems": 1,
                  "type": "array",
                  "uniqueItems": true
                },
                "source": {
                  "maxLength": 64,
                  "minLength": 1,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "type": "string"
                },
                "version": {
                  "oneOf": [
                    {
                      "additionalProperties": false,
                      "properties": {
                        "commit": {
                          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "commit"
                      ],
                      "type": "object"
                    },
                    {
                      "additionalProperties": false,
                      "properties": {
                        "ref": {
                          "pattern": "^refs/(heads|tags)/[^\\s]+$",
                          "type": "string"
                        }
                      },
                      "required": [
                        "ref"
                      ],
                      "type": "object"
                    }
                  ]
                },
                "when": {
                  "additionalProperties": false,
                  "minProperties": 1,
                  "properties": {
                    "architectures": {
                      "items": {
                        "enum": [
                          "x86_64",
                          "arm64",
                          "x86"
                        ]
                      },
                      "minItems": 1,
                      "type": "array",
                      "uniqueItems": true
                    },
                    "platforms": {
                      "items": {
                        "enum": [
                          "windows",
                          "macos",
                          "linux"
                        ]
                      },
                      "minItems": 1,
                      "type": "array",
                      "uniqueItems": true
                    }
                  },
                  "required": [],
                  "type": "object"
                }
              },
              "required": [
                "source",
                "id"
              ],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": [
          "skills"
        ],
        "type": "object"
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "packages": {
      "additionalProperties": {
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
      },
      "type": "object"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "schema_version",
    "packages"
  ],
  "type": "object"
}
